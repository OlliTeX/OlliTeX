extends ../layout-react

block entrypointVar
	- entrypoint = 'pages/auth/password-reset'

block vars
	// OLiT Mantine surface (owner hub #2, 2026-09-16): /user/password/reset
	// renders through the React entry (pages/auth/password-reset) with the
	// shared ollitex Mantine provider — the same design system as /login
	// and /register. The form itself stays a native data-ol-async-form
	// (identical server contract: POST /user/password/reset, _csrf,
	// rate limiting, optional invisible captcha, message bag).
	- suppressNavbar = true
	- suppressNavbarRight = true
	- suppressFooter = true
	- suppressPugCookieBanner = true
	- showThinFooter = false
	- hideNavLogo = true
	- hideBrandTitle = true

block append meta
	- var showCaptcha = settings.recaptcha && settings.recaptcha.siteKey && !(settings.recaptcha.disabled && settings.recaptcha.disabled.passwordReset)
	meta(name='ol-password-reset-captcha' data-type='boolean' content=(showCaptcha ? 'true' : 'false'))
	meta(name='ol-password-reset-error' data-type='string' content=(error || ''))

block content
	if showCaptcha
		script(
			type='text/javascript'
			nonce=scriptNonce
			src='https://www.recaptcha.net/recaptcha/api.js?render=explicit'
		)
		div(
			id='recaptcha'
			class='g-recaptcha'
			data-sitekey=settings.recaptcha.siteKey
			data-size='invisible'
			data-badge='inline'
		)

	#auth-root(data-ol-captcha-retry-trigger-area='')
