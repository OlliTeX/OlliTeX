extends ../layout-react

block entrypointVar
	- entrypoint = 'pages/auth/login'

block vars
	// OLiT Mantine surface (owner scope): /login renders through the React
	// entry (pages/auth/login) with the shared ollitex Mantine provider.
	// Brand-only chrome, as before (2026-09-01 owner decision).
	- suppressNavbar = true
	- suppressNavbarRight = true
	- suppressFooter = true
	- suppressPugCookieBanner = true
	- showThinFooter = false
	- hideNavLogo = true
	- hideBrandTitle = true

block append meta
	// SSO buttons + LDAP field behaviour + support text — built by the
	// controller (UserPagesController.loginPage already resolves the SSO
	// sections request-locally).
	meta(name='ol-auth-config' data-type='json' content=authConfigJson)

block content
	#auth-root
