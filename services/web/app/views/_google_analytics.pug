// 2026-09 (owner audit item: "does OlliTeX send analytics to overleaf.com?"):
// NO — and this is now enforced. The upstream conditional Google Analytics
// loader (googletagmanager.com / google-analytics.com) has been REMOVED:
// OlliTeX is self-hosted and self-contained with zero external telemetry.
// Only inert window stubs remain so code guarded by
// `typeof window.ga === 'function'` (frontend event-tracking) stays a no-op.
// See services/web/config/settings.defaults.js (`analytics.enabled: false`)
// and server-ce/config/settings.js (pinned off).
script(type="text/javascript", nonce=scriptNonce).
  window.gtag = function() { /* OlliTeX: external analytics disabled — no-op */ };
  window.ga = function() { /* OlliTeX: external analytics disabled — no-op */ };
  window.ga.q = [];
