extends ../../../../app/views/layout-react

block entrypointVar
	- entrypoint = 'pages/auth/register'

block vars
	// OLiT Mantine surface (owner scope): /register renders through the
	// React entry (pages/auth/register) with the shared ollitex Mantine
	// provider. Brand-only chrome (2026-09-01 owner decision).
	- suppressNavbar = true
	- suppressNavbarRight = true
	- suppressFooter = true
	- suppressPugCookieBanner = true
	- showThinFooter = false
	- hideNavLogo = true
	- hideBrandTitle = true

block append meta
	// Context + domain restrictions (built by the module controller).
	meta(name='ol-auth-config' data-type='json' content=authConfigJson)

block content
	#auth-root
