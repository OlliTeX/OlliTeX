extends ../../../../app/views/layout-react

block entrypointVar
	- entrypoint = 'modules/ollitex-hub/pages/hub'

block vars
	- const hideNavLogo = true
	- const hideBrandTitle = true
	- const suppressNavContentLinks = true
	- const suppressNavbar = true
	- const suppressFooter = true
	- const suppressPugCookieBanner = true
	- const showThinFooter = false

block append meta
	meta(name='ol-user' data-type='json' content=hubUserJson)
	meta(name='ol-userSettings' data-type='json' content=userSettings)
	meta(name='ol-overallThemes' data-type='json' content=overallThemes)
	meta(name='ol-hub-admin' data-type='boolean' content=hubAdmin)
	meta(name='ol-hub-theme' data-type='json' content=(hubTheme ? JSON.stringify(hubTheme) : 'null'))
	//- ol-ExposedSettings: provided by layout-base (ExpressLocals.ExposedSettings); declaring it here too trips the in-image webpack meta-tag duplicate check.
	meta(name='ol-gitBridgeEnabled' data-type='boolean' content=gitBridgeEnabled)

block content
	.olkit-hub#hub-root
