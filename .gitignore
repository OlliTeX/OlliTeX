# docker image build
.dockerignore

# user defined files
.env
docker-compose.override.yml

# dependencies — never uploaded
node_modules/

# tool caches (eslint/babel/webpack)
services/web/.cache/
frontend/.cache/

# yarn PnP cache + runtime artifacts (built locally, never committed — GH 100MB limit)
.yarn/cache/
.pnp.cjs
.pnp.loader.mjs

# reproducible phase-0 crawl artifacts (regenerable via parity/crawl/crawl.mjs)
tests/e2e/parity/reference/

# build temp working docs (kept on disk as owner reference; excluded from the
# OlliTeX repo tree — see .gitignore owner note 2026-09-16)
/PLAN.md
/plan_6.2.0_6.2.1.md
/plan_6.2.1_6.2.2.md
/plan_6.2.2_6.3.0.md
/UI_ROUND10_PLAN.md
/UI_ROUND11_PLAN.md
/UI_ROUND12_PLAN.md
/SSO_TEST_ENV_README.md
/TOOLKIT_ENV_GAP.md
/BRANDING.md
/ext_explain.md
# local working documents (plans/bug-hunts/problem reports) — never committed
/local-plans/

# Go service build output (make go-build)
/bin/

# local Go web build artifact (container /usr/local/bin/go-services/web is canonical)
/web

# Web static build output (P7 step 6: public/ moved to repo root; webpack output.path → <root>/public)
/public/manifest.json
/public/js
/public/minjs
/public/stylesheets
/public/fonts
/public/images
/public/*.module.wasm

# Web app (frontend/) build artifacts (P7 step 5: frontend/ moved to repo root)
/frontend/js/features/source-editor/themes/ace/
/frontend/js/features/source-editor/lezer-latex/latex.mjs
/frontend/js/features/source-editor/lezer-latex/latex.terms.mjs
/frontend/js/features/source-editor/lezer-bibtex/bibtex.mjs
/frontend/js/features/source-editor/lezer-bibtex/bibtex.terms.mjs

# Clsitypst (Go typst compile service) local test/runtime cache artifacts —
# created by urlcache/resourcewriter tests under the package-local cache dir;
# generated locally, never committed (GH 100MB limit / non-reproducible values).
go/services/clsitypst/resourcewriter/cache/
go/services/clsitypst/urlcache/cache/
