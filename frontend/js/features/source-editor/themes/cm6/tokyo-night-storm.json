{
  "theme": {
    "&": {
      "backgroundColor": "#24283b",
      "color": "#7982a9"
    },
    ".cm-gutters": {
      "background": "#24283b",
      "color": "#7982a9",
      "borderRightColor": "transparent"
    },
    ".cm-cursor, .cm-dropCursor": {
      "color": "#c0caf5"
    },
    "&.cm-focused .cm-selectionBackground, .cm-selectionBackground, ::selection": {
      "backgroundColor": "#6f7bb630"
    },
    ".cm-activeLine": {
      "backgroundColor": "#292e427a"
    },
    ".cm-tooltip": {
      "backgroundColor": "#24283b",
      "color": "#7982a9"
    }
  },
  "highlightStyle": {
    ".tok-keyword": {
      "color": "#bb9af7"
    },
    ".tok-variableName": {
      "color": "#c0caf5"
    },
    ".tok-propertyName": {
      "color": "#7aa2f7"
    },
    ".tok-string": {
      "color": "#9ece6a"
    },
    ".tok-function": {
      "color": "#7aa2f7"
    },
    ".tok-label": {
      "color": "#7aa2f7"
    },
    ".tok-literal": {
      "color": "#bb9af7"
    },
    ".tok-type": {
      "color": "#c0caf5"
    },
    ".tok-number": {
      "color": "#ff9e64"
    },
    ".tok-namespace": {
      "color": "#ff9e64"
    },
    ".tok-comment": {
      "color": "#565f89"
    },
    ".tok-invalid": {
      "color": "#ff5370"
    }
  },
  "dark": true
}
