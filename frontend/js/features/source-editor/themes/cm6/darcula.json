{
  "theme": {
    "&": {
      "backgroundColor": "#2B2B2B",
      "color": "#f8f8f2"
    },
    ".cm-gutters": {
      "background": "rgba(255, 255, 255, 0.1)",
      "color": "#999",
      "borderRightColor": "transparent"
    },
    ".cm-cursor, .cm-dropCursor": {
      "color": "#FFFFFF"
    },
    "&.cm-focused .cm-selectionBackground, .cm-selectionBackground, ::selection": {
      "backgroundColor": "rgba(255, 255, 255, 0.1)"
    },
    ".cm-activeLine": {
      "backgroundColor": "rgba(255, 255, 255, 0.1)"
    },
    ".cm-tooltip": {
      "backgroundColor": "rgba(255, 255, 255, 0.1)",
      "color": "#f8f8f2"
    }
  },
  "highlightStyle": {
    ".tok-literal": {
      "color": "#bd93f9"
    },
    ".tok-number": {
      "color": "#bd93f9"
    },
    ".tok-comment": {
      "color": "#61A151"
    },
    ".tok-string": {
      "color": "#6A8759"
    },
    ".tok-variableName": {
      "color": "#A9B7C6"
    },
    ".tok-type": {
      "color": "#A9B7C6"
    },
    ".tok-propertyName": {
      "color": "#FFC66D"
    },
    ".tok-keyword": {
      "color": "#CC7832"
    }
  },
  "dark": true
}
