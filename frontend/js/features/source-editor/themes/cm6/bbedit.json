{
  "theme": {
    "&": {
      "backgroundColor": "#FFFFFF",
      "color": "#000000"
    },
    ".cm-gutters": {
      "background": "#f5f5f5",
      "color": "#4D4D4C",
      "borderRightColor": "transparent"
    },
    ".cm-cursor, .cm-dropCursor": {
      "color": "#FBAC52"
    },
    "&.cm-focused .cm-selectionBackground, .cm-selectionBackground, ::selection": {
      "backgroundColor": "#FFD420"
    },
    ".cm-activeLine": {
      "backgroundColor": "#00000012"
    },
    ".cm-tooltip": {
      "backgroundColor": "#f5f5f5",
      "color": "#000000"
    }
  },
  "highlightStyle": {
    ".tok-comment": {
      "color": "#804000"
    },
    ".tok-keyword": {
      "color": "#0000FF"
    },
    ".tok-number": {
      "color": "#FF0080"
    },
    ".tok-string": {
      "color": "#FF0080"
    },
    ".tok-variableName": {
      "color": "#006600"
    },
    ".tok-heading": {
      "color": "#0C07FF"
    },
    ".tok-function": {
      "color": "#0000A2"
    },
    ".tok-type": {
      "color": "#6D79DE"
    }
  },
  "dark": false
}
