# OlliTeX Toolkit compose — environment template (the workspace blocks dotted
# env files, so this lives as env.example: `cp env.example .env && vi .env`).
# compose.yaml reads ONLY the variables below.
#
#   Run: cp env.example .env && vi .env && docker compose --env-file .env up -d

# Q3: the host base dir (the "one mounted folder" contract).
#   ${PREFIX}/data       toolkit data dir (host key, settings snapshots, journal)
#   ${PREFIX}/data/ssl   self-signed CA + server cert (auto-generated, Q5)
#   ${PREFIX}/ssh        authorized_keys + id_ed25519 (auto-generated, Q4)
PREFIX=/data_1/test_x/opt/ollitex

# Q2: THE shared password — one secret for both postgres (POSTGRES_PASSWORD)
# and the toolkit's CONFIG_DB_DSN (compose interpolates it into the DSN).
# Generate:  openssl rand -hex 24
PG_PASSWORD=

# Host port the stack Postgres is published on (default 15432).
PG_PORT=15432
