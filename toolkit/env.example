# ==================================================================
#  OlliTeX Toolkit — canonical env (copy to .env, keep .env UNTRACKED)
#  Owner 2026-10-06: ONE stack file (toolkit/compose.yaml), ONE flag
#  contract (restart: ${ENABLE_*}) for optional groups, normal port
#  numbers as DEFAULTS — env overrides exist for dev work / conflicts.
# ==================================================================

# -- stack -----------------------------------------------------------
PREFIX=/data_1/test_x/opt/ollitex
PG_PASSWORD=__SET_ME__
OLLITEX_SSH_ALLOW_PASSWORD=false
OLLITEX_SSH_AUTH_TIMEOUT=30

# -- image pins (owner-mandated) --------------------------------------
POSTGRES_IMAGE=postgres:18-alpine   # canonical (2026-10-06: 16 debug cluster wiped, owner; 18 root-mount layout)
POSTGRES_BACKUP_IMAGE=prodrigestivill/postgres-backup-local:18
MONGO_IMAGE=mongo:9.0
REDIS_IMAGE=redis:8.10-alpine3.23
PROMETHEUS_IMAGE=prom/prometheus:v2.53.1
GRAFANA_IMAGE=grafana/grafana-oss:11.6.0
MONGODB_EXPORTER_IMAGE=percona/mongodb_exporter:0.43.0
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.58.0-alpine
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
PROBE_IMAGE=busybox:1.36
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:latest
WAKA_API_IMAGE=ghcr.io/muety/wakapi:latest
LANGUAGE_TOOL_IMAGE=erikvl87/languagetool:latest

# -- service groups: restart policy flag (no = off) -------------------
#  Active by default (no / unless-stopped; owner D 2026-10-06).
ENABLE_SEAWEEDFS=unless-stopped
ENABLE_WAKA_API=unless-stopped
ENABLE_LANGUAGE_TOOL=unless-stopped
ENABLE_MONITORING=unless-stopped
ENABLE_HAPROXY=unless-stopped      # web facade (owner D 2026-10-06)
ENABLE_OLLITEX_WEB=unless-stopped  # the web app (owner D 2026-10-06)

# -- host ports (NORMAL defaults; override for dev / conflict boxes) --
#  Core three --------------------------------------------------------
PG_PORT_HOST=5432             # ollitex-pg host binding (container 5432)
MONGO_PORT_HOST=27017         # overleafmongo (container 27017)
REDIS_PORT_HOST=6379          # overleafredis (container 6379)
SSH_PORT=2222                 # toolkit SSH/TUI (container 2222)
#  Monitoring group ----------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
MONGODB_EXPORTER_PORT=9216
REDIS_EXPORTER_PORT=9121
NODE_EXPORTER_PORT=9100
#  SeaweedFS group -------------------------------------------------------
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_MASTER_GRPC_PORT=19333
SEAWEEDFS_FILER_PORT=8888      # filer HTTP (4.46 default; legacy-proven) — override if busy
SEAWEEDFS_FILER_GRPC_PORT=18888
SEAWEEDFS_S3_PORT=8333         # S3 API — the app contract (OVERLEAF_FILESTORE_S3_ENDPOINT=http://seaweedfs-s3:8333)
SEAWEEDFS_VOLUME_PORT=8080     # volume HTTP
SEAWEEDFS_VOLUME_GRPC_PORT=18080
#  Optional services ------------------------------------------------------
WAKA_API_PORT=3002            # normal-ish (3000=grafana, 3001=forgejo on this box)
LANGUAGE_TOOL_PORT=8010

# -- monitoring plane ---------------------------------------------------
GRAFANA_CSP_FRAME_ANCESTORS=self
# Grafana kiosk embed (server-ce/grafana): explicit opt-in
GRAFANA_ANONYMOUS=false
GRAFANA_CSP_FRAME_ANCESTORS=self

#  Web plane (absorbed into compose.yaml; owner D 2026-10-06) -------------
HAPROXY_PORT=80
HAPROXY_TLS_PORT=443

# ── web plane (in compose.yaml; absorbed 2026-10-06 from compose-web) ──
#  Optional-group flags (above): ENABLE_HAPROXY / ENABLE_OLLITEX_WEB
WEB_IMAGE=ollitex/ollitex:main
HAPROXY_IMAGE=haproxy:2.8
TZ=UTC
OLLITEX_DB=ollitex                 # NEW app DB (legacy `sharelatex` stays untouched)
# -- web secrets / runtime (values in LOCAL .env, never committed) -------
#   OVERLEAF_SESSION_SECRET=<openssl rand -hex 32>   (REQUIRED)
#   OVERLEAF_INVITE_TOKEN_SECRET=<openssl rand -hex 32>
#   LLM_KEY_SECRET=<openssl rand -hex 32>
#   OT_JWT_AUTH_KEY=<openssl rand -hex 32>
# -- web integration (optional, sane compose defaults) ------------------
GIT_BRIDGE_HOST=git-bridge
GIT_BRIDGE_PORT=8000
HUB_GRAFANA_EMBED_URL=https://psintern.neuro.uni-bremen.de/grafana
# Grafana kiosk embed (AJ-3, owner 2026-10-08): the Instance statistics
# section is the Grafana system (served under https://<host>/grafana/ via the
# haproxy isgraf branch — single edge, only 80/443 exposed);
# the kiosk loads with Grafana's anonymous Viewer role (no password needed):
#GRAFANA_ANONYMOUS=true
#GRAFANA_CSP_FRAME_ANCESTORS='self' https://psintern.neuro.uni-bremen.de
# -- legacy file import target (object store = the S3 plane) ------------
S3_IMPORT_BUCKET=ollitex-legacy

# ── dev infrastructure plane (compose-dev-infrastructure.yaml; owner H)
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:15
LLM_MOCK_IMAGE=ollitex/llm-mock:main
MOCK_SAML_IMAGE=boxyhq/mock-saml:latest
OPENLDAP_IMAGE=osixia/openldap:1.5.0
SSO_OIDC_IMAGE=sso-oidc:latest
MAILSINK_IMAGE=sso-mailsink:latest
CONFORM_NGINX_IMAGE=oidc-conform-nginx:latest
CONFORM_SUITE_IMAGE=authelia/openid-connect-conformance-suite:latest
# normal ports (defaults in compose): FORGEJO_PORT=3000 LLM_MOCK_PORT=8000
# SAML_MOCK_PORT=4000 LDAP_PORT=389 LDAP_TLS_PORT=636 OIDC_PORT=8080
# MAILSINK_PORT=25 CONFORM_NGINX_PORT=8443 CONFORM_NGINX_ALT_PORT=8444
LDAP_ADMIN_PASSWORD=admin_password   # DEV fixture credential (documented)

# B5 (2026-10-06): private registry ollitex.registry:11435
ENABLE_REGISTRY=unless-stopped
REGISTRY_PORT=${REGISTRY_PORT:-11435}

# durable file content: the fs filestore data dir bound into ollitex-web (owner H: web+filestore same plane)
FILESTORE_DATA_DIR=${PREFIX}/data/overleaf

# ── sub-service plane (Node-parity env the Go sub-services read inside ollitex-web) ──
# canonical Mongo for collab/realtime/chat/docstore/filestore/history-v1 (container DNS, container 27017):
MONGO_CONNECTION_STRING=mongodb://overleafmongo:27017/ollitex
OLLITEX_DB_NAME=ollitex
# history-v1 PG plane (chunks/zip tables): DATABASE_URL=postgres://user:PASS@ollitex-pg:5432/overleaf (PG_PASSWORD passed through)
# S3 persistor/filestore endpoint (canonical SeaweedFS, anonymous by default): AWS_S3_ENDPOINT=http://seaweedfs-s3:8333
AWS_S3_ENDPOINT=http://seaweedfs-s3:8333
AWS_S3_PATH_STYLE=true
# admin privilege (node parity: settings.defaults.js ADMIN_PRIVILEGE_AVAILABLE):
ADMIN_PRIVILEGE_AVAILABLE=true

# ── prod app settings (source of truth on psintern: /data_1/docker/compose_cep/.env) ──
OVERLEAF_SITE_URL=https://overleaf.example.tld          # the public URL of THIS install
OVERLEAF_APP_NAME=Testserver
OVERLEAF_NAV_TITLE=Testserver
OVERLEAF_CUSTOM_EMAIL_FOOTER=Testserver
OVERLEAF_ADMIN_EMAIL=admin@overleaf.example.tld
OVERLEAF_EMAIL_FROM_ADDRESS=noreply@overleaf.example.tld
OVERLEAF_EMAIL_SMTP_HOST=smtp.example.tld
OVERLEAF_EMAIL_SMTP_PORT=465
OVERLEAF_EMAIL_SMTP_SECURE=true
OVERLEAF_EMAIL_SMTP_USER=overleaf
OVERLEAF_EMAIL_PASSWORD=
OVERLEAF_EMAIL_SMTP_IGNORE_TLS=false
OVERLEAF_OIDC_ISSUER=
OVERLEAF_OIDC_CLIENT_ID=
OVERLEAF_OIDC_CLIENT_SECRET=
OVERLEAF_OIDC_IDENTITY_SERVICE_NAME=Log in with SSO (Testserver)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL_NAME=
CRYPTO_RANDOM=
WEB_API_PASSWORD=

# prod facade binding: 0.0.0.0 = externally reachable (134.102.55.230:80/:443); 127.0.0.1 = dev/loopback only
OVERLEAF_LISTEN_IP=0.0.0.0

# v1 history basic-auth (web -> historyv1 history service); BOTH sides read this key,
# user defaults to "staging". Example:
#V1_HISTORY_PASSWORD=change-me-32-hex

# v1 history S3: "false" drops If-None-Match (required for SeaweedFS S3
# emulation; defaults on for real AWS/minio):
#OVERLEAF_HISTORY_S3_IF_NONE_MATCH=false

# ── AJ-4 (2026-10-08, owner): instance-fixed knobs — ENV-OWNED, no admin-UI ──
# These were removed from /admin-settings per the owner ("these should be
# env vars"): the UI sections were retired; the values below are the
# deployment contract.
#
# Git integration (git bridge host/port):
#GITBRIDGE_HOST=git-bridge
#GIT_BRIDGE_PORT=8000
#
# Grammar / LanguageTool (server URL + activation):
#ENABLE_LANGUAGE_TOOL=unless-stopped
#LANGUAGE_TOOL_PORT=8010
#
# Local storage (SeaweedFS) endpoint + buckets (filestore, historyv1,
# docstore archive = "archives" per the Go filestore default):
# (AWS_S3_ENDPOINT / AWS_S3_PATH_STYLE are set above — the one canonical pair)
#
# Sandboxed compiles — container host (host dirs, socket, image user are
# image/plane owned; the body-size limit remains in the admin Compilation
# page):
OLLITEX_COMPILE_DIR=/data_1/ols/compiles        # compile work dir (mounted)
#SANDBOXED_COMPILES_HOST_DIR_COMPILES=
#SANDBOXED_COMPILES_HOST_DIR_OUTPUT=
#SANDBOXED_COMPILES_HOST_DIR_CACHE=
#
# Typst compiles — FIXED ON (owner): the clsi_typst service URL is the Go
# services plane (127.0.0.1:3014 in-container); there is no runtime switch.
# Pandoc — FIXED ON (owner 2026-10-08 AK-8): Word/Markdown/HTML exports are
# enabled via env (the admin UI section was retired):
#ENABLE_PANDOC_CONVERSIONS=true
#PANDOC_IMAGE=ollitex/pandoc:main
#
# AK-5 (owner 2026-10-08): the selectable sandbox compile images (the list
# in the /editor settings modal Compiler pane + the admin Compilation page):
#ALL_TEX_LIVE_DOCKER_IMAGES=texlive/texlive:latest-full,texlive/texlive:TL2025-historic
#ALL_TEX_LIVE_DOCKER_IMAGE_NAMES=TeXLive rolling,TeXLive 2025
#TEX_LIVE_DOCKER_IMAGE=texlive/texlive:latest-full
#
# Companion service addresses (web -> service URLs) are the in-container
# 127.0.0.1 Go plane (3013 clsitex / 3014 clsitypst / 3016 docstore /
# 3009 filestore) — not user-configurable.
