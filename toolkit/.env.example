
FILESTORE_DATA_DIR=/data_1/docker/compose_cep/overleafserver/data   # durable file content (fs filestore data dir)

# ── SUB-SERVICE PLANE (Node-parity env the Go sub-services read) ─────────────
# canonical Mongo for collab/realtime/chat/docstore/filestore/history-v1:
MONGO_CONNECTION_STRING=mongodb://overleafmongo:27017/ollitex
OLLITEX_DB_NAME=ollitex
# history-v1 PG plane (chunks/zip tables): DATABASE_URL=postgres://user:PASS@ollitex-pg:5432/overleaf  (PG_PASSWORD is passed through)
# S3 persistor/filestore endpoint (canonical SeaweedFS, anonymous by default):
AWS_S3_ENDPOINT=http://seaweedfs-s3:8333
AWS_S3_PATH_STYLE=true
# admin privilege (node parity: settings.defaults.js ADMIN_PRIVILEGE_AVAILABLE):
ADMIN_PRIVILEGE_AVAILABLE=true
