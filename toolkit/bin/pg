#!/usr/bin/env bash
# bin/pg — operator psql against the toolkit Postgres (shared config DB +
# history DSN plane). Args pass through to psql.
set -euo pipefail

TOOLKIT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source "$TOOLKIT_ROOT/lib/shared-functions.sh"

if [[ "${POSTGRES_ENABLED:-false}" != "true" ]]; then
  echo "POSTGRES_ENABLED is not true in config/overleaf.rc" >&2
  exit 1
fi

# shellcheck disable=SC1091
exec env SKIP_WARNINGS=true "$TOOLKIT_ROOT/bin/docker-compose" exec postgres \
  psql -U "${POSTGRES_USER:-overleaf}" "${POSTGRES_DB:-overleaf}" "$@"
