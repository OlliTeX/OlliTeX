# Default values for config/overleaf.rc (OlliTeX Toolkit)
#
# Image versions live in ONE place: lib/images.env (see that file).
# User overrides belong in config/overleaf.rc (created by bin/init).

PROJECT_NAME=ollitex
OVERLEAF_DATA_PATH=data/ollitex
OVERLEAF_LISTEN_IP=127.0.0.1
OVERLEAF_PORT=80

# Sibling containers (sandboxed compiles in dedicated containers)
SIBLING_CONTAINERS_ENABLED=false
DOCKER_SOCKET_PATH=/var/run/docker.sock
SIBLING_CONTAINERS_PULL=true

# Mongo configuration
MONGO_ENABLED=true
MONGO_DATA_PATH=data/mongo
MONGO_URL=mongodb://mongo/sharelatex

# Postgres — the shared config DB (SINGLE SOURCE OF TRUTH, owner decision
# 2026-10-04) and the DSN plane historyv1's chunk/blob stores use.
# Image pin: lib/images.env (postgres:18-alpine). Mount contract for
# postgres:18+: the mount goes at /var/lib/postgresql (data lives in the
# image-managed ./data subdir — a mount point directly at .../data is
# rejected by the 18+ image).
# POSTGRES_PASSWORD: generated by bin/init (config/overleaf.rc) — never a
# committed constant.
POSTGRES_ENABLED=true
POSTGRES_DATA_PATH=data/postgres
POSTGRES_USER=overleaf
POSTGRES_DB=overleaf

# Redis configuration
REDIS_ENABLED=true
REDIS_DATA_PATH=data/redis
REDIS_HOST=redis
REDIS_PORT=6379

# TLS proxy configuration (optional; see doc/tls-proxy.md)
NGINX_ENABLED=false
NGINX_CONFIG_PATH=config/nginx/nginx.conf
NGINX_HTTP_PORT=80
TLS_PORT=443

# LanguageTool (optional grammar checking service)
# See doc/language-toolkit.md + bin/languagetool-ngrams
LANGUAGE_TOOL_ENABLED=false
LANGUAGE_TOOL_PORT=8010
LANGUAGE_TOOL_DATA_PATH=data/languagetool
# Comma-separated n-gram languages downloaded by bin/languagetool-ngrams
LANGUAGE_TOOL_NGRAM_LANGUAGES=en,de,es,fr,de

# SeaweedFS (DEFAULT local S3 storage for filestore + docstore):
# 4 containers on the shared network, started FIRST (master ->
# volume/filer -> s3) before the app; data under
# ${OVERLEAF_DATA_PATH}/seaweedfs; host ports 9333/19333/18080/
# 8888/18888/8333 (S3 gateway). The app is seeded with the S3 storage env:
# OVERLEAF_FILESTORE_BACKEND=s3,
# OVERLEAF_FILESTORE_S3_ENDPOINT=http://seaweedfs-s3:8333, buckets
# template/blobs/global; docstore BACKEND=s3, BUCKET_NAME=archives,
# AWS_S3_ENDPOINT. Default ON (the S3-only durable storage backend);
# set SEAWEEDFS_ENABLED=false to revert to the previous local-fs layout.
# See lib/docker-compose.seaweedfs.yml (header) for the full contract.
SEAWEEDFS_ENABLED=true
