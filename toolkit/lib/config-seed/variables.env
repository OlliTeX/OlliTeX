# Container environment for the OlliTeX server.
# ----------------------------------------------------------------------------
# Branding (app name, nav title, footers, logos) and most admin settings are
# managed in the WEB UI since the hub wave (2026-09):
#   • Site branding / footer / nav title : /hub → Admin → Site
#   • Appearance (light/dark theme)      : /hub → Admin → Site → Appearance
#   • LanguageTool / LLM / Integrations  : /hub → Admin → Site → …
#   • Notifications & personal settings  : /hub → My settings
# The entries below stay as bootstrap defaults / CI overrides — they are
# hydrated into site settings at boot (EnvHydrator), so for day-to-day
# administration prefer the hub UI (it wins once a value is set there).
# ----------------------------------------------------------------------------

OVERLEAF_APP_NAME="OlliTeX"

ENABLED_LINKED_FILE_TYPES=project_file,project_output_file

# Enables Thumbnail generation using an external converter (pdftocairo by default)
ENABLE_CONVERSIONS=true

# Disables email confirmation requirement
EMAIL_CONFIRMATION_DISABLED=true

# Secret generated at bin/init time
OVERLEAF_INVITE_TOKEN_SECRET=

## Public URL + proxy (bootstrap — needed before the admin UI exists)
# OVERLEAF_SITE_URL=http://ollitex.example.com
# OVERLEAF_BEHIND_PROXY=true
# OVERLEAF_SECURE_COOKIE=true
# OVERLEAF_ADMIN_EMAIL=support@example.com

## Branding below is editable in /hub → Admin → Site (kept here as
## bootstrap defaults only).
# OVERLEAF_NAV_TITLE=OlliTeX
# OVERLEAF_HEADER_IMAGE_URL=http://somewhere.com/mylogo.png
# OVERLEAF_HEADER_IMAGE_URL_LIGHT=http://somewhere.com/my-light-logo.png
# OVERLEAF_HEADER_IMAGE_URL_DARK=http://somewhere.com/my-dark-logo.png
# OVERLEAF_LEFT_FOOTER='[{"text": "Contact your support team", "url": "mailto:support@example.com"}]'
# OVERLEAF_RIGHT_FOOTER='[{"text": "Hello, I am on the Right"}]'

## Email (SMTP) — bootstrap; see /hub → Admin → Site for the display address
# OVERLEAF_EMAIL_FROM_ADDRESS=team@example.com
#
# OVERLEAF_EMAIL_AWS_SES_ACCESS_KEY_ID=
# OVERLEAF_EMAIL_AWS_SES_SECRET_KEY=
#
# OVERLEAF_EMAIL_SMTP_HOST=smtp.example.com
# OVERLEAF_EMAIL_SMTP_PORT=587
# OVERLEAF_EMAIL_SMTP_SECURE=false
# OVERLEAF_EMAIL_SMTP_USER=
# OVERLEAF_EMAIL_SMTP_PASS=
# OVERLEAF_EMAIL_SMTP_NAME=
# OVERLEAF_EMAIL_SMTP_LOGGER=false
# OVERLEAF_EMAIL_SMTP_TLS_REJECT_UNAUTH=true
# OVERLEAF_EMAIL_SMTP_IGNORE_TLS=false
# OVERLEAF_CUSTOM_EMAIL_FOOTER=This system is run by department x

## LDAP (optional; admin UI does not manage LDAP — env stays canonical)
EXTERNAL_AUTH=none
# OVERLEAF_LDAP_URL=ldap://ldap:389
# OVERLEAF_LDAP_SEARCH_BASE=ou=people,dc=planetexpress,dc=com
# OVERLEAF_LDAP_SEARCH_FILTER=(uid={{username}})
# OVERLEAF_LDAP_BIND_DN=cn=admin,dc=planetexpress,dc=com
# OVERLEAF_LDAP_BIND_CREDENTIALS=GoodNewsEveryone
# OVERLEAF_LDAP_EMAIL_ATT=mail
# OVERLEAF_LDAP_NAME_ATT=cn
# OVERLEAF_LDAP_LAST_NAME_ATT=sn
# OVERLEAF_LDAP_UPDATE_USER_DETAILS_ON_LOGIN=true

## Templates (admin-managed in /hub → Admin)
# OVERLEAF_TEMPLATES_USER_ID=578773160210479700917ee5
# OVERLEAF_NEW_PROJECT_TEMPLATE_LINKS=[{"name":"All Templates","url":"/templates/all"}]

## Typst (owner 2026-09-13): enabled ON by default in the OlliTeX build.
## The typst compile image is digest-pinned (see lib/images.env →
## TYPST_IMAGE) and runs with network disabled — no env needed.
# COMPILE_TYPEST_ENABLED=false   # rollback switch (off by default: ON)

## LanguageTool (optional service — see overleaf.rc LANGUAGE_TOOL_ENABLED)
# LANGUAGETOOL_URL=http://languagetool:8010

## S3 storage (optional; SaaS-free: plain S3 API — see doc/configuration.md)
# OVERLEAF_FILESTORE_BACKEND=s3
#
# ## Bucket name for project files
# OVERLEAF_FILESTORE_USER_FILES_BUCKET_NAME=overleaf-user-files
# ## Bucket name for template files
# OVERLEAF_FILESTORE_TEMPLATE_FILES_BUCKET_NAME=overleaf-template-files
# ## Key/secret for filestore user
# OVERLEAF_FILESTORE_S3_ACCESS_KEY_ID=...
# OVERLEAF_FILESTORE_S3_SECRET_ACCESS_KEY=...
# ## Bucket endpoint + region (pick your provider)
# OVERLEAF_FILESTORE_S3_ENDPOINT=
# OVERLEAF_FILESTORE_S3_REGION=""
# OVERLEAF_FILESTORE_S3_PATH_STYLE="true"
#
# ## Project history
# OVERLEAF_HISTORY_BACKEND=s3
# OVERLEAF_HISTORY_PROJECT_BLOBS_BUCKET=overleaf-project-blobs
# OVERLEAF_HISTORY_CHUNKS_BUCKET=overleaf-chunks
# OVERLEAF_HISTORY_S3_ACCESS_KEY_ID=...
# OVERLEAF_HISTORY_S3_SECRET_ACCESS_KEY=...
# OVERLEAF_HISTORY_S3_ENDPOINT=
# OVERLEAF_HISTORY_S3_REGION=""
# OVERLEAF_HISTORY_S3_PATH_STYLE="true"

## Sibling-container compile images (comma separated; see lib/images.env)
# TEXLIVE_IMAGE=quay.io/sharelatex/texlive-full:2026.1
