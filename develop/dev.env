# OlliTeX local dev env (Go superstack; rewritten 2026-11-16).
#
# The OLD Node-split host vars (CHAT_HOST, CLSI_HOST, DOCSTORE_HOST,
# FILESTORE_HOST, NOTIFICATIONS_HOST, WEBPACK_HOST, WEB_HOST,
# QUEUES_REDIS_HOST, DOWNLOAD_HOST) are RETIRED with the junk/services-web
# split: the Go superstack image runs those sidecars INSIDE the web
# container (loopback), per the world-A / e2e / prod topology. Kept commented
# per the owner deletion gate (archive-first, then delete).
#
# docker-compose.yml carries the full env contract (mirrored from the proven
# e2e stack); this file provides local toggles + fixtures it reads.

# ---- data plane ----
LISTEN_ADDRESS=0.0.0.0
GRACEFUL_SHUTDOWN_DELAY_SECONDS=0
MONGO_HOST=mongo
MONGO_URL=mongodb://mongo/sharelatex?directConnection=true
REDIS_HOST=redis

# ---- local dev session/fixtures (dev-only values, same style as before) ----
SESSION_SECRET=dev-local-session-secret-not-for-prod
WEB_API_USER=overleaf
WEB_API_PASSWORD=overleaf

# [retired Node split — archive-first, owner gate]
# CHAT_HOST=chat
# CLSI_HOST=clsi
# DOWNLOAD_HOST=clsi-nginx
# DOCSTORE_HOST=docstore
# FILESTORE_HOST=filestore
# NOTIFICATIONS_HOST=notifications
# QUEUES_REDIS_HOST=redis
# DSMP_REDIS_HOST=redis
# WEBPACK_HOST=webpack
# WEB_HOST=web
# ── LLM / AI features (modules/llm) ─────────────────────────────────────
# Optional; with none of these set, no LLM/AI features are visible.
# LLM_ENABLED=true          # load the LLM module (chat, completion, LLM grammar)
# LLM_API_URL=http://llm-host/v1
# LLM_API_KEY=your-api-key
# LLM_MODEL_NAME=model-a,model-b   # or: LLM_AVAILABLE_MODELS=...
# LLM_ALLOW_USER_SETTINGS=true     # per-user BYO provider rows (default true in module)
# LLM_ADMIN_SETTINGS_PATH=/var/lib/overleaf/data/llm-admin-settings.json
# ── LanguageTool (grammar check) ────────────────────────────────────────
# The compose 'languagetool' service + the LANGUAGE_TOOL_HOST/PORT vars pre-set
# in docker-compose.yml cover the default case. Override with:
# LANGUAGE_TOOL_URL=http://languagetool:8010   # full URL wins over HOST/PORT
# LANGUAGE_TOOL_LEVEL=picky                     # default check level ('picky' or 'default')
