#!/bin/bash

source /etc/overleaf/env.sh

# Go 1:1 replacement (cutover plan A3, owner-approved 2026-09-14):
# USE_GO_DROPBOXINTERFACE=true (env.sh or compose env) selects the Go binary; otherwise the
# canonical Node entrypoint runs unchanged.
# Rollback = unset USE_GO_DROPBOXINTERFACE + `sv restart dropboxinterface-overleaf` — same env, same log file, same user.
if [ "$USE_GO_DROPBOXINTERFACE" = "true" ]; then
    exec /sbin/setuser www-data /usr/local/bin/go-services/dropboxinterface >> /var/log/overleaf/dropboxinterface.log 2>&1
fi
exec /sbin/setuser www-data /usr/bin/node /overleaf/services/dropboxinterface/app/src/index.mjs >> /var/log/overleaf/dropboxinterface.log 2>&1
