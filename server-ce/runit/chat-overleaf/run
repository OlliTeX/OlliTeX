#!/bin/bash

# chat is served by its Go implementation (cutover plan, Phase C complete
# 2026-09-16: Node==Go contract gates green on e2e + live). The Node version
# was removed from this tree; Go is the canonical implementation.
source /etc/overleaf/env.sh
export LISTEN_ADDRESS=127.0.0.1

export METRICS_APP_NAME="ollitex-chat"  # D22 A2: the app label for the ometrics default labels
#
## D22: Prometheus instrumentation on the internal port (/metrics;
## the HAProxy edge never forwards it).
exec /sbin/setuser www-data /usr/local/bin/go-services/chat >> /var/log/overleaf/chat.log 2>&1
