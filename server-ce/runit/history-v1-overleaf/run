#!/bin/bash

# G2/H1 flip (HISTORY_V1_GO=1): the Go history-v1 service (runit
# history-v1-go-overleaf) owns :3100 and this Node service stands down.
# Default off → unchanged behavior anywhere (no env).
if [ "${HISTORY_V1_GO:-0}" = "1" ]; then
    echo "history-v1-overleaf: HISTORY_V1_GO=1 — standing down (Go owns :3100)"
    exec sleep infinity
fi

NODE_PARAMS=""
if [ "$DEBUG_NODE" == "true" ]; then
    echo "running debug - history-v1"
    NODE_PARAMS="--inspect=0.0.0.0:30640"
fi

NODE_CONFIG_DIR=/overleaf/services/history-v1/config exec /sbin/setuser www-data /usr/bin/node $NODE_PARAMS /overleaf/services/history-v1/app.js >> /var/log/overleaf/history-v1.log 2>&1
