#!/bin/bash

NODE_PARAMS=""
if [ "$DEBUG_NODE" == "true" ]; then
    echo "running debug - clsi_typst"
    NODE_PARAMS="--inspect=0.0.0.0:30131"
fi

# Set permissions on docker.sock if present,
# To enable sibling-containers (see entrypoint.sh in clsi project)
if [ -e '/var/run/docker.sock' ]; then
  echo ">> Setting permissions on docker socket"
  DOCKER_GROUP=$(stat -c '%g' /var/run/docker.sock)
  groupadd --non-unique --gid "${DOCKER_GROUP}" dockeronhost
  usermod -aG dockeronhost www-data
fi

source /etc/overleaf/env.sh
export LISTEN_ADDRESS=127.0.0.1

# clsi_typst MUST compile through the sandboxed DockerRunner: typst exists
# only in the digest-pinned pandoc/typst image (it is NOT installed inside
# the overleaf container, so the local runner would fail — verified live
# 2026-09-10). DOCKER_RUNNER=true is scoped to this service (the tex clsi
# keeps its local-runner CE mode); settings.defaults.cjs then applies the
# typst docker image + allowedImages gate (clsi docker.sock permissions
# are set above).
export DOCKER_RUNNER=true

# Sandbox compile dirs — DockerRunner's SAME-PATH contract: the host path
# (for the docker daemon's bind) and the service's view must be the same
# absolute string, so deployments bind each TYPST_*_DIR at the identical
# container path (compose_cep + e2e compose do this). Defaults follow the
# overleaf data root; a deployment WITHOUT the matching bind must set
# TYPST_COMPILES_DIR/TYPST_OUTPUT_DIR (or leave the flag off, where the
# service answers 501 and the menu is hidden by the web gate).
export COMPILES_DIR="${TYPST_COMPILES_DIR:-/var/lib/overleaf/typst/compiles}"
export SANDBOXED_COMPILES_HOST_DIR_COMPILES="$COMPILES_DIR"
export TYPST_OUTPUT_DIR="${TYPST_OUTPUT_DIR:-/var/lib/overleaf/typst/output}"
export SANDBOXED_COMPILES_HOST_DIR_OUTPUT="$TYPST_OUTPUT_DIR"
mkdir -p "$COMPILES_DIR" "$TYPST_OUTPUT_DIR" 2>/dev/null || true

# typst compile service (plan §4/§5: runit sibling of clsi-overleaf,
# digest-pinned pandoc/typst image runs as host docker child process,
# uid 33, network-disabled sandbox)
exec /sbin/setuser www-data /usr/bin/node $NODE_PARAMS /overleaf/services/clsi_typst/app.js >> /var/log/overleaf/clsi_typst.log 2>&1
