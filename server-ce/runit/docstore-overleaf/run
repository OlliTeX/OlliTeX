#!/bin/bash

NODE_PARAMS=""
if [ "$DEBUG_NODE" == "true" ]; then
    echo "running debug - docstore"
    NODE_PARAMS="--inspect=0.0.0.0:30160"
fi

source /etc/overleaf/env.sh
export LISTEN_ADDRESS=127.0.0.1

# Go 1:1 replacement (cutover plan A3, owner-approved 2026-09-14):
# USE_GO_DOCSTORE=true (env.sh or compose env) selects the Go binary; otherwise the
# canonical Node entrypoint runs unchanged.
# Rollback = unset USE_GO_DOCSTORE + `sv restart docstore-overleaf` — same env, same log file, same user.
if [ "$USE_GO_DOCSTORE" = "true" ]; then
    exec /sbin/setuser www-data /usr/local/bin/go-services/docstore >> /var/log/overleaf/docstore.log 2>&1
fi
exec /sbin/setuser www-data /usr/bin/node $NODE_PARAMS /overleaf/services/docstore/app.js >> /var/log/overleaf/docstore.log 2>&1
