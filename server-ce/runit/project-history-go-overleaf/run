#!/bin/bash

# project-history (GO 1:1 port) — owns :3054 (V2 service) when
# PROJECT_HISTORY_GO=1 (the flip that retires the Node project-history
# service). Inert (sleep) when the flip is off so the two implementations
# can never collide; this is the default everywhere the flip is off.
#
# Env (vendor settings.defaults 1:1 via internal/config):
#   MONGO_CONNECTION_STRING, REDIS_HOST/PORT/PASSWORD,
#   WEB_API_USER/PASSWORD, V1_HISTORY_*, UPLOAD_FOLDER.
source /etc/overleaf/env.sh
if [ "${PROJECT_HISTORY_GO:-0}" != "1" ]; then
    exec sleep infinity
fi
export LISTEN_ADDRESS=127.0.0.1

exec /sbin/setuser www-data /usr/local/bin/go-services/project-history >> /var/log/overleaf/project-history-go.log 2>&1
