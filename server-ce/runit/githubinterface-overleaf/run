#!/bin/bash

source /etc/overleaf/env.sh

# Go 1:1 replacement (cutover plan A3, owner-approved 2026-09-14):
# USE_GO_GITHUBINTERFACE=true (env.sh or compose env) selects the Go binary; otherwise the
# canonical Node entrypoint runs unchanged.
# Rollback = unset USE_GO_GITHUBINTERFACE + `sv restart githubinterface-overleaf` — same env, same log file, same user.
if [ "$USE_GO_GITHUBINTERFACE" = "true" ]; then
    exec /sbin/setuser www-data /usr/local/bin/go-services/githubinterface >> /var/log/overleaf/githubinterface.log 2>&1
fi
exec /sbin/setuser www-data /usr/bin/node -e "import('/overleaf/services/githubinterface/app/src/server.mjs')" >> /var/log/overleaf/githubinterface.log 2>&1
