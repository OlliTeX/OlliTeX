#!/bin/bash

source /etc/overleaf/env.sh

# Go 1:1 replacement (cutover plan A3, owner-approved 2026-09-14):
# USE_GO_WEBDAVINTERFACE=true (env.sh or compose env) selects the Go binary; otherwise the
# canonical Node entrypoint runs unchanged.
# Rollback = unset USE_GO_WEBDAVINTERFACE + `sv restart webdavinterface-overleaf` — same env, same log file, same user.
if [ "$USE_GO_WEBDAVINTERFACE" = "true" ]; then
    exec /sbin/setuser www-data /usr/local/bin/go-services/webdavinterface >> /var/log/overleaf/webdavinterface.log 2>&1
fi
exec /sbin/setuser www-data /usr/bin/node /overleaf/services/webdavinterface/app/src/server.mjs >> /var/log/overleaf/webdavinterface.log 2>&1
