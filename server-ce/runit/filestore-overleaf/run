#!/bin/bash

source /etc/overleaf/env.sh
export LISTEN_ADDRESS=127.0.0.1

# Go 1:1 replacement (cutover plan A3, owner-approved 2026-09-14):
# USE_GO_FILESTORE=true (env.sh or compose env) selects the Go binary; otherwise the
# canonical Node entrypoint runs unchanged.
# Rollback = unset USE_GO_FILESTORE + `sv restart filestore-overleaf` — same env, same log file, same user.
if [ "$USE_GO_FILESTORE" = "true" ]; then
    exec /sbin/setuser www-data /usr/local/bin/go-services/filestore >> /var/log/overleaf/filestore.log 2>&1
fi
exec /sbin/setuser www-data /usr/bin/node /overleaf/services/filestore/app.js >> /var/log/overleaf/filestore.log 2>&1
