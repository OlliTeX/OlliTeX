#!/bin/bash

# filestore is served by its Go implementation (cutover plan, Phase C complete
# 2026-09-16: Node==Go contract gates green on e2e + live). The Node version
# was removed from this tree; Go is the canonical implementation.
source /etc/overleaf/env.sh
export LISTEN_ADDRESS=127.0.0.1

exec /sbin/setuser www-data /usr/local/bin/go-services/filestore >> /var/log/overleaf/filestore.log 2>&1
