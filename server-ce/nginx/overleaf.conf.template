server {
	listen         80;
	server_name    _; # Catch all, see http://nginx.org/en/docs/http/server_names.html

	root /overleaf/public/;

	# block external access to prometheus /metrics
	location /metrics {
		internal;
	}

	# ACME HTTP-01 challenge webroot (edge: HAProxy proxies this path here;
	# owner mounts the certbot webroot dir into /var/www/acme). Served as
	# plain files; a missing mount simply 404s (harmless in e2e/self-host
	# setups without ACME).
	location ^~ /.well-known/acme-challenge/ {
		alias /var/www/acme/;
		try_files $uri =404;
	}

	location / {
		proxy_pass http://127.0.0.1:4000;
		proxy_http_version 1.1;
		# B (owner queue 2026-09-30, def #1): the unconditional
		# `Connection "upgrade"` header was a copy-paste from the socket.io
		# block — it forced nginx into pass-through framing for EVERY proxied
		# response (API + HTML + static) even though none of them are
		# websockets. Removed: plain HTTP/1.1 proxy.
		# B (def #1, root cause): with proxy buffering ON, nginx spills
		# upstream responses (~32KB+) into /var/lib/nginx/tmp/proxy — which
		# www-data cannot write (permission denied, [crit] in
		# error.log): every spilling response (e.g. the 394KB /js pages
		# chunk) intermittently truncated with a 200 + full Content-Length
		# → browser ERR_CONTENT_LENGTH_MISMATCH → dead editor. Pass-through
		# is the right mode for a same-host Go upstream anyway (fast, no
		# temp files, no ownership coupling).
		proxy_buffering off;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_read_timeout 10m;
		proxy_send_timeout 10m;
	}

	location ^~ /git/ {
		resolver_timeout 2s;
		resolver 127.0.0.11 valid=10s;
		set $git_upstream http://${GIT_BRIDGE_HOST}:${GIT_BRIDGE_PORT};
		rewrite ^/git/(.*)$ /$1 break;
		client_max_body_size ${GIT_BRIDGE_REPOSTORE_MAX_FILE_SIZE};
		proxy_pass $git_upstream;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_read_timeout 10m;
		proxy_send_timeout 10m;
	}

	location /socket.io {
		proxy_pass http://127.0.0.1:3026;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		# H3 (D36 pattern from /collab): forward $http_host (port kept) — the
		# realtime same-origin check compares host-parts and tolerates the
		# proxy-stripped case either way.
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_read_timeout 10m;
		proxy_send_timeout 10m;
	}

	# Ollitex Go collab service (D19 collaboration pivot, 2026-09-25) — the
	# Yjs/ygo real-time rooms. Same-origin pass: browser y-websocket clients
	# hit /collab/{projectId}; ygo's default origin policy is a same-origin
	# check (Origin host == HTTP Host) which this pass satisfies (Host is
	# forwarded as $host). The runit service (server-ce/runit/collab-overleaf)
	# listens on 127.0.0.1:3450. WS Upgrade headers are mandatory here — the
	# y-protocol handshake fails with a plain HTTP pass.
	location /collab {
		proxy_pass http://127.0.0.1:3450;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		# D36: $host strips the port → ygo same-origin (Origin host == r.Host)
		# rejects the browser WS handshake (403). $http_host = raw Host header
		# WITH port, matching the browser's Origin host.
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_read_timeout 10m;
		proxy_send_timeout 10m;
	}

	location /stylesheets {
		expires 1y;
	}

	location /minjs {
		expires 1y;
	}

	location /img {
		expires 1y;
	}

	# B (owner queue 2026-09-30): the webpack JS chunks + fonts are plain
	# files in /overleaf/public — serve them static from nginx (sendfile,
	# native ETag/Range/304) instead of proxying through the Go web.
	# The /js proxy path was the truncation casualty above; static serving
	# also keeps the Go web free of the heaviest read traffic.
	location ^~ /js {
		expires 1y;
	}

	location ^~ /fonts {
		expires 1y;
	}

  # handle output files for specific users
  location ~ ^/project/([0-9a-f]+)/user/([0-9a-f]+)/build/([0-9a-f-]+)/output/output\.([a-z.]+)$ {
		proxy_pass http://127.0.0.1:8080; # clsi-nginx.conf
		proxy_http_version 1.1;
  }
  # handle output files for anonymous users
  location ~ ^/project/([0-9a-f]+)/build/([0-9a-f-]+)/output/output\.([a-z.]+)$ {
		proxy_pass http://127.0.0.1:8080; # clsi-nginx.conf
		proxy_http_version 1.1;
  }
  # PDF range for specific users
  location ~ ^/project/([0-9a-f]+)/user/([0-9a-f]+)/content/([0-9a-f-]+/[0-9a-f]+)$ {
		proxy_pass http://127.0.0.1:8080; # clsi-nginx.conf
		proxy_http_version 1.1;
  }
  # PDF range for anonymous users
  location ~ ^/project/([0-9a-f]+)/content/([0-9a-f-]+/[0-9a-f]+)$ {
		proxy_pass http://127.0.0.1:8080; # clsi-nginx.conf
		proxy_http_version 1.1;
  }

  # block external access to metrics
  location ~* ^/metrics/?$ {
    return 404 'Not found';
  }

  # block external access to all health checks /health_check, /health_check/full, etc
  location ~* ^/health_check {
    return 404 'Not found';
  }

  # Load any extra configuration for this vhost
  include /etc/nginx/vhost-extras/overleaf/*.conf;
}
