# Default values for config/overleaf.rc (OlliTeX Toolkit)
#
# Image versions live in ONE place: lib/images.env (see that file).
# User overrides belong in config/overleaf.rc (created by bin/init).

PROJECT_NAME=ollitex
OVERLEAF_DATA_PATH=data/ollitex
OVERLEAF_LISTEN_IP=127.0.0.1
OVERLEAF_PORT=80

# Sibling containers (sandboxed compiles in dedicated containers)
SIBLING_CONTAINERS_ENABLED=false
DOCKER_SOCKET_PATH=/var/run/docker.sock
SIBLING_CONTAINERS_PULL=true

# Mongo configuration
MONGO_ENABLED=true
MONGO_DATA_PATH=data/mongo
MONGO_URL=mongodb://mongo/sharelatex

# Redis configuration
REDIS_ENABLED=true
REDIS_DATA_PATH=data/redis
REDIS_HOST=redis
REDIS_PORT=6379

# TLS proxy configuration (optional; see doc/tls-proxy.md)
NGINX_ENABLED=false
NGINX_CONFIG_PATH=config/nginx/nginx.conf
NGINX_HTTP_PORT=80
TLS_PORT=443

# LanguageTool (optional grammar checking service)
# See doc/language-toolkit.md + bin/languagetool-ngrams
LANGUAGE_TOOL_ENABLED=false
LANGUAGE_TOOL_PORT=8010
LANGUAGE_TOOL_DATA_PATH=data/languagetool
# Comma-separated n-gram languages downloaded by bin/languagetool-ngrams
LANGUAGE_TOOL_NGRAM_LANGUAGES=en,de,es,fr,de
