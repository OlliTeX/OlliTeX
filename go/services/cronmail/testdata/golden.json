   "html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"en\" xml:lang=\"en\">\n<head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <meta name=\"x-apple-disable-message-reformatting\">\n  <!--[if mso]>\n  <style type=\"text/css\">\n    body, table, td, p, a, li { font-family: Arial, Helvetica, sans-serif !important; }\n  </style>\n  <![endif]-->\n  <style>\n    body { margin: 0; padding: 0; background-color: #f4f5f6; }\n    img { border: 0; display: block; outline: none; text-decoration: none; }\n    .email-layout-table { border-collapse: collapse !important; }\n    a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }\n\n    .force-overleaf-style a,\n    .force-overleaf-style a[href] {\n      color: #1e6b41 !important;\n      text-decoration: underline !important;\n      -moz-hyphens: none;\n      -ms-hyphens: none;\n      -webkit-hyphens: none;\n      hyphens: none;\n    }\n    .force-overleaf-style a:visited,\n    .force-overleaf-style a[href]:visited { color: #1e6b41; }\n    .force-overleaf-style a:hover,\n    .force-overleaf-style a[href]:hover { color: #155a30; }\n\n    @media only screen and (min-width: 621px) {\n      .email-card-inner { padding: 56px !important; }\n    }\n    @media only screen and (max-width: 620px) {\n      .email-container { width: 100% !important; max-width: 100% !important; }\n      .email-outer-cell { padding: 0 10px !important; }\n      .email-header-cell { padding: 16px 0 !important; }\n    }\n  </style>\n</head>\n<body bgcolor=\"#f4f5f6\" style=\"margin: 0; padding: 0; background-color: #f4f5f6; font-family: Arial, Helvetica, sans-serif;\">\n\n  <!-- Prevent Gmail iOS font size manipulation -->\n  <div style=\"display: none; white-space: nowrap; font: 15px courier; line-height: 0;\">\n    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\n    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\n  </div>\n\n  <table class=\"email-layout-table\" role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" bgcolor=\"#f4f5f6\" style=\"background-color: #f4f5f6; min-width: 100%;\">\n    <tr>\n      <td class=\"email-outer-cell\" align=\"center\" valign=\"top\" style=\"padding: 40px 10px;\">\n\n        <!--[if mso]>\n        <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" align=\"center\"><tr><td>\n        <![endif]-->\n        <table class=\"email-container email-layout-table\" role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width: 600px;\">\n\n          <!-- Logo header -->\n          <tr>\n            <td class=\"email-header-cell\" style=\"padding: 0 0 24px 0;\">\n              <span style=\"font-family: Arial, Helvetica, sans-serif; font-size: 30px; font-weight: bold; color: #04652f;\">OlliTeX</span>\n            </td>\n          </tr>\n\n          <!-- White content card -->\n          <tr>\n            <td bgcolor=\"#ffffff\" style=\"background-color: #ffffff; border-radius: 8px; overflow: hidden;\">\n              <table class=\"email-layout-table\" role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                <tr>\n                  <td\n                    class=\"email-card-inner\"\n                    style=\"padding: 32px 24px; font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.5; color: #1b222c;\"\n                  >\n                    \n<h2 style=\"margin: 0 0 16px 0; font-family: Arial, Helvetica, sans-serif; font-size: 30px; font-weight: 600; color: #1b222c; line-height: 40px;\">\n  New Comment\n</h2>\n\n\n\n\n\n<p class=\"force-overleaf-style\" style=\"margin: 0 0 16px 0;\">\n  A new comment has been posted in project.\n</p>\n\n\n<table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin: 32px 0;\">\n  <tr>\n    <td bgcolor=\"#098842\" style=\"background-color: #098842; border-radius: 9999px; padding: 6px 16px; text-align: center;\">\n      <a href=\"http://127.0.0.1:4000/project/p3\" style=\"color: #ffffff; display: block; font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-weight: 600; line-height: 24px; text-align: center; text-decoration: none; -webkit-hyphens: none; -ms-hyphens: none; hyphens: none;\">\n        View comment\n      </a>\n    </td>\n  </tr>\n</table>\n\n\n  \n  <p class=\"force-overleaf-style\" style=\"margin: 0 0 16px 0;\">\n    View the project to read the full thread and respond.\n  </p>\n  \n\n\n<p style=\"margin: 0 0 4px 0; font-size: 14px; line-height: 20px; color: #495365;\">\n  If the button above does not appear, please copy and paste this link into your browser's address bar:\n</p>\n<p style=\"margin: 0; font-size: 14px; line-height: 20px; word-break: break-all;\">\n  <a href=\"http://127.0.0.1:4000/project/p3\" style=\"color: #1e6b41; text-decoration: none;\">http://127.0.0.1:4000/project/p3</a>\n</p>\n\n\n<script type=\"application/ld+json\">\n  {\"@context\":\"http://schema.org\",\"@type\":\"EmailMessage\",\"potentialAction\":{\"@type\":\"ViewAction\",\"target\":\"http://127.0.0.1:4000/project/p3\",\"url\":\"http://127.0.0.1:4000/project/p3\",\"name\":\"View comment\"},\"description\":\"View the recent comment on project\"}\n</script>\n\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Footer spacer -->\n          <tr>\n            <td style=\"height: 24px; font-size: 24px; line-height: 24px; mso-line-height-rule: exactly;\">&nbsp;</td>\n          </tr>\n\n          <!-- Footer tagline -->\n          <tr>\n            <td align=\"center\" style=\"padding: 0 0 48px 0;\">\n              \n            </td>\n          </tr>\n\n          <!-- Footer site info -->\n          \n\n          \n\n        </table>\n        <!--[if mso]>\n        </td></tr></table>\n        <![endif]-->\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
