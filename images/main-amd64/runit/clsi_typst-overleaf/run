#!/bin/bash

# clsi_typst (Typst compile service) — GO SERVICE (go/services/clsitypst),
# baked at /usr/local/bin/go-services/clsitypst by images/main-amd64/Dockerfile
# (gobuilder loop). Node services/clsi_typst RETIRED from the runit dispatch
# 2026-10-02 (c09; 1:1 Go port, oracle-verified). The Node dir is left in the
# tree as rollback until the Go path is proven live (c11+c12 bake), but it is
# no longer exec'd here.

# Set permissions on docker.sock if present,
# To enable sibling-containers (docker.sock is mounted into the overleaf
# container; www-data must be able to create the typst compile containers).
# busybox (alpine) needs addgroup/adduser; shadow-utils (Debian) groupadd/usermod.
if [ -e '/var/run/docker.sock' ]; then
  echo ">> Setting permissions on docker socket"
  DOCKER_GROUP=$(stat -c '%g' /var/run/docker.sock)
  if command -v groupadd 2>/dev/null; then
    groupadd --non-unique --gid "${DOCKER_GROUP}" dockeronhost || true
    usermod -aG dockeronhost www-data
  else
    addgroup -g "${DOCKER_GROUP}" dockeronhost 2>/dev/null || true
    adduser www-data dockeronhost 2>/dev/null || true
  fi
fi

source /etc/overleaf/env.sh
export LISTEN_ADDRESS=127.0.0.1

# ---- typst compile feature gate ------------------------------------------------
# ON by default (owner: Typst is a first-class always-on feature; the Go config
# reads COMPILE_TYPEST_ENABLED, default true unless "false").
export COMPILE_TYPEST_ENABLED="${COMPILE_TYPEST_ENABLED:-true}"

# ---- sandboxed-Docker compile runner (the SAME-PATH contract) -----------------
# The Go service (config.New) REQUIRES DOCKER_RUNNER/SANDBOXED_COMPILES plus a
# SANDBOXED_COMPILES_HOST_DIR_COMPILES, and DockerRunner binds
#   <SANDBOXED_COMPILES_HOST_DIR_COMPILES>/<proj>/<user>/<name>  ->  /compile
# inside the typst container. The service's own compiles view therefore must be
# the SAME absolute string (the classic clsi same-path contract), so the host
# bind and the service write target coincide. Defaults follow the overleaf data
# root; a deployment WITHOUT the matching bind must keep the two in agreement
# (or the service refuses to start, which is the safe failure).
export DOCKER_RUNNER=true
export SANDBOXED_COMPILES=true

# ---- compile dirs (2026-10-08 fix: AK-12 typst compile produced no PDF) ----
# The run script previously defaulted these to /var/lib/overleaf/typst/* and
# exported the SAME strings as SANDBOXED_COMPILES_HOST_DIR_* (the "same-path
# contract"). In the toolkit layout /var/lib/overleaf/typst is NOT a mount —
# so the daemon-side bind auto-created a PHANTOM host dir that was empty
# (main.typ never reached the compile container: "no output.pdf generated"),
# while the daemon also ignored the deployment's real host dirs
# (SANDBOXED_COMPILES_HOST_DIR_*= /data_1/ols/*, set in the container env).
#
# Fix: service view = the MOUNTED data tree (the same host dirs as the tex
# compile plane, mounted at /var/lib/overleaf/data/* inside this container —
# writes land on the host directly); daemon bind = the SANDBOXED_COMPILES_HOST_DIR_*
# values from the deployment env when present (they are already correct), kept
# intact below instead of being overwritten with the container-local strings.
# Honor explicit overrides first (TYPSF_*_DIR, classic names), then the
# mounted tree, keeping legacy behaviour for flat deployments where
# /var/lib/overleaf IS the bind target.
_TYPSF_COMPILES="${TYPSF_COMPILES_DIR:-${TYPSF_COMPILES:-}}"
[ -z "$_TYPSF_COMPILES" ] && [ -d /var/lib/overleaf/data/compiles ] && _TYPSF_COMPILES=/var/lib/overleaf/data/compiles
[ -z "$_TYPSF_COMPILES" ] && _TYPSF_COMPILES=/var/lib/overleaf/typst/compiles
_TYPSF_OUTPUT="${TYPSF_OUTPUT_DIR:-${TYPSF_OUTPUT:-}}"
[ -z "$_TYPSF_OUTPUT" ] && [ -d /var/lib/overleaf/data/output ] && _TYPSF_OUTPUT=/var/lib/overleaf/data/output
[ -z "$_TYPSF_OUTPUT" ] && _TYPSF_OUTPUT=/var/lib/overleaf/typst/output
_TYPSF_CACHE="${TYPSF_CACHE_DIR:-${TYPSF_CACHE:-}}"
[ -z "$_TYPSF_CACHE" ] && [ -d /var/lib/overleaf/data/cache ] && _TYPSF_CACHE=/var/lib/overleaf/data/cache
[ -z "$_TYPSF_CACHE" ] && _TYPSF_CACHE=/var/lib/overleaf/typst/cache
_TYPSF_UPLOAD="${TYPSF_UPLOAD_DIR:-/var/lib/overleaf/tmp/typst-uploads}"

# service-view dirs (what the Go binary reads as c.Path.*)
export CLSI_TYPST_COMPILES_PATH="$_TYPSF_COMPILES"
export CLSI_TYPST_OUTPUT_PATH="$_TYPSF_OUTPUT"
export CLSI_TYPST_CACHE_PATH="$_TYPSF_CACHE"
export CLSI_TYPST_UPLOAD_PATH="$_TYPSF_UPLOAD"
# host-side bind dirs (docker daemon view): KEEP the deployment-provided
# SANDBOXED_COMPILES_HOST_DIR_* when already set (toolkit: /data_1/ols/* —
# correct); only fall back to the service strings for flat deployments where
# the two views coincide.
: "${SANDBOXED_COMPILES_HOST_DIR_COMPILES:=$_TYPSF_COMPILES}"
: "${SANDBOXED_COMPILES_HOST_DIR_OUTPUT:=$_TYPSF_OUTPUT}"
: "${SANDBOXED_COMPILES_HOST_DIR_CACHE:=$_TYPSF_CACHE}"
export SANDBOXED_COMPILES_HOST_DIR_COMPILES SANDBOXED_COMPILES_HOST_DIR_OUTPUT SANDBOXED_COMPILES_HOST_DIR_CACHE

mkdir -p "$_TYPSF_COMPILES" "$_TYPSF_OUTPUT" "$_TYPSF_CACHE" "$_TYPSF_UPLOAD" 2>/dev/null || true

# ---- typst image --------------------------------------------------------------
# The typst binary lives in the pinned typst docker image (it is NOT installed
# inside the overleaf container; the compile runs as a docker child process).
# TYPST_IMAGE / TYPST_DOCKER_IMAGE select the image; the default is the
# digest-pinned VANILLA pandoc/typst (safe: compiles, no synctex). For the
# SYNCTEX crown jewel (click-to-source via output.sourcemap.json) the deployment
# MUST set:
#   TYPST_IMAGE=ollitex/typst:<ref>
# which is the image built from images/typst-amd64/Dockerfile (typst fork
# 0.15.1-with-extras + the clsi-sourcemap patch). Never synctex on vanilla.
export TYPST_IMAGE="${TYPST_IMAGE:-pandoc/typst:latest-alpine@sha256:ae9dfa3c58cae72d363484442993b761ff4bc30202ec12823bc1e59fa952c892}"

# root runner, same rationale as clsi-overleaf (empty-sandbox regression,
# 2026-10-06): clsitypst must create/write/chown the typst sandbox dirs.
exec /usr/local/bin/go-services/clsitypst >> /var/log/overleaf/clsi_typst.log 2>&1
