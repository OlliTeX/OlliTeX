#!/bin/bash

NODE_PARAMS=""
if [ "$DEBUG_NODE" == "true" ]; then
    echo "running debug - clsi"
    NODE_PARAMS="--inspect=0.0.0.0:30130"
fi

# Set permissions on docker.sock if present,
# To enable sibling-containers (see entrypoint.sh in clsi project)
if [ -e '/var/run/docker.sock' ]; then
  echo ">> Setting permissions on docker socket"
  DOCKER_GROUP=$(stat -c '%g' /var/run/docker.sock)
  # portable: groupadd/usermod are shadow-utils (Debian); the alpine base
  # (busybox) needs addgroup/adduser instead (proven 2026-09-28 alpine spike).
  if command -v groupadd 2>/dev/null; then
    groupadd --non-unique --gid "${DOCKER_GROUP}" dockeronhost || true
    usermod -aG dockeronhost www-data
  else
    addgroup -g "${DOCKER_GROUP}" dockeronhost 2>/dev/null || true
    adduser www-data dockeronhost 2>/dev/null || true
  fi
fi

source /etc/overleaf/env.sh
export LISTEN_ADDRESS=127.0.0.1

# CLSI is the Go service (go/services/clsitex, baked as go-services/clsitex in
# images/main-amd64/Dockerfile). Node services/clsi retired 2026-09-29 (1:1 Go port,
# oracle-verified: full unit suite + 80,782-row safe_pathname oracle green).
export ENABLE_PANDOC_CONVERSIONS=true  # audit-013 (owner 2026-10-01): Word/Markdown/HTML export via pandoc
# clsitex MUST run as root, not www-data (2026-10-06, live-proven regression):
# the sandboxed compile dir is bind-mounted host->texlive container and the
# docker daemon AUTO-CREATES it root:root when missing. A www-data runner
# cannot create dirs in the parent, cannot write main.tex into a root-owned
# dir, and cannot chown (no CAP_CHOWN) — result: empty sandbox +
# "Could not find file 'main.tex'" (owner project 671bd3cf..., 17:44/18:07
# repros). Root runner creates+writes the sandbox freely and chowns it to the
# compile container's DockerUser (go dockerrunner.ensureCompileDirOwnership),
# matching the legacy node clsi which ran as root under the same runsv.
exec /usr/local/bin/go-services/clsitex >> /var/log/overleaf/clsi.log 2>&1
